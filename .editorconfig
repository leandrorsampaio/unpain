# EditorConfig — https://editorconfig.org
# Keeps indentation and whitespace consistent across editors for contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python backend uses 4-space indentation.
[*.py]
indent_size = 4

# Markdown: trailing spaces are significant (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Vendored assets are third-party — don't impose our rules on them.
[app/static/vendor/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
