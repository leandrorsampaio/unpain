{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-month findings",
  "type": "object",
  "required": ["month", "findings"],
  "properties": {
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "transaction_ids", "issue", "suggestion"],
        "properties": {
          "kind": { "enum": ["amount-anomaly", "possible-duplicate", "new-recurring", "category-outlier", "missing-counterpart", "sharing-suspicion"] },
          "transaction_ids": { "type": "array", "items": { "type": "string" } },
          "issue": { "type": "string" },
          "suggestion": { "type": "string" },
          "severity": { "enum": ["info", "check", "important"] }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
